        {
          "selector": "p",
          "count": 2
        },
        {
          "selector": "br",
          "count": 1
        },
        {
          "selector": "strong",
          "text": "strong"
        },
        {
          "selector": "em",
          "text": "em"
        },
        {
          "selector": "del",
          "text": "del"
        }
      ],
      "absentSelectors": []
    },
