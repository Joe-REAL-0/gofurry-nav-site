    {
      "id": "heading-levels",
      "kind": "markdown",
      "input": "# One\n\n## Two\n\n### Three\n\n#### Four\n\n##### Five\n\n###### Six",
      "elements": [
        {
          "selector": "h2",
          "text": "One"
        },
        {
          "selector": "h3",
          "text": "Two"
        },
        {
          "selector": "h4",
          "text": "Three"
        },
        {
          "selector": "h5",
          "text": "Four"
        },
        {
          "selector": "h6",
          "count": 2
        }
      ],
      "absentSelectors": [
        "h1"
      ]
    },
    {
      "id": "paragraph-breaks-emphasis",
