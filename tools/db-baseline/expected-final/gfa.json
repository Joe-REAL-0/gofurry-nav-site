  "tables": [
    {
      "name": "gfa_admin_account",
      "comment": "Admin 本地账号身份、密码凭证与会话撤销版本；权限映射由编译代码持有",
      "columns": [
        {
          "name": "id",
          "data_type": "bigint",
          "not_null": true,
          "has_default": true,
          "default": "nextval('gfa_admin_account_id_seq'::regclass)",
          "comment": "Admin 本地账号身份、密码凭证与会话撤销版本的行身份；用于稳定引用该记录"
        },
        {
          "name": "password_hash",
          "data_type": "text",
          "not_null": true,
          "has_default": false,
          "comment": "登录密码的单向哈希凭证，不保存明文密码"
        },
        {
          "name": "session_version",
          "data_type": "bigint",
          "not_null": true,
          "has_default": true,
          "default": "1",
          "comment": "该账号的会话撤销版本；变更后旧版本登录令牌失效"
        },
        {
          "name": "created_at",
          "data_type": "timestamp(0) without time zone",
          "not_null": true,
          "has_default": false,
          "comment": "Admin 本地账号身份、密码凭证与会话撤销版本的记录创建时间"
        },
        {
          "name": "updated_at",
          "data_type": "timestamp(0) without time zone",
          "not_null": true,
          "has_default": false,
          "comment": "Admin 本地账号身份、密码凭证与会话撤销版本的记录最近更新时间"
        },
        {
          "name": "password_updated_at",
          "data_type": "timestamp(0) without time zone",
          "not_null": false,
          "has_default": false,
          "comment": "最近设置或重置密码的时间；历史账号可能为 NULL"
        },
        {
          "name": "username",
          "data_type": "text",
          "not_null": true,
          "has_default": false,
          "comment": "规范化小写登录名，去除首尾空白且在账号域内唯一"
        },
        {
          "name": "display_name",
          "data_type": "text",
          "not_null": true,
          "has_default": false,
          "comment": "后台显示名称；审计记录保存操作发生时的名称快照"
        },
        {
          "name": "role",
          "data_type": "text",
          "not_null": true,
          "has_default": false,
          "comment": "固定角色 owner、developer 或 operator；能力集合由后端策略推导"
        },
        {
          "name": "status",
          "data_type": "text",
          "not_null": true,
          "has_default": false,
          "comment": "账号可用状态：active 可登录，disabled 禁止登录"
        },
        {
          "name": "last_login_at",
          "data_type": "timestamp(0) without time zone",
          "not_null": false,
          "has_default": false,
          "comment": "最后一次成功登录时间；从未登录时为 NULL"
        }
      ],
      "constraints": [
        {
          "name": "gfa_admin_account_created_at_not_null",
          "definition": "NOT NULL created_at"
        },
        {
          "name": "gfa_admin_account_display_name_check",
          "definition": "CHECK (btrim(display_name) \u003c\u003e ''::text AND display_name = btrim(display_name) AND length(display_name) \u003c= 128)"
        },
        {
          "name": "gfa_admin_account_display_name_not_null",
          "definition": "NOT NULL display_name"
        },
        {
          "name": "gfa_admin_account_id_not_null",
          "definition": "NOT NULL id"
        },
        {
          "name": "gfa_admin_account_password_hash_not_null",
          "definition": "NOT NULL password_hash"
        },
        {
          "name": "gfa_admin_account_pkey",
          "definition": "PRIMARY KEY (id)"
        },
        {
          "name": "gfa_admin_account_role_check",
          "definition": "CHECK (role = ANY (ARRAY['owner'::text, 'developer'::text, 'operator'::text]))"
        },
        {
          "name": "gfa_admin_account_role_not_null",
          "definition": "NOT NULL role"
        },
        {
          "name": "gfa_admin_account_session_version_check",
          "definition": "CHECK (session_version \u003e 0)"
        },
        {
          "name": "gfa_admin_account_session_version_not_null",
          "definition": "NOT NULL session_version"
        },
        {
          "name": "gfa_admin_account_status_check",
          "definition": "CHECK (status = ANY (ARRAY['active'::text, 'disabled'::text]))"
        },
        {
          "name": "gfa_admin_account_status_not_null",
          "definition": "NOT NULL status"
        },
        {
          "name": "gfa_admin_account_updated_at_not_null",
          "definition": "NOT NULL updated_at"
        },
        {
          "name": "gfa_admin_account_username_check",
          "definition": "CHECK (username = lower(btrim(username)) AND username ~ '^[a-z0-9][a-z0-9._-]{2,63}$'::text)"
        },
        {
          "name": "gfa_admin_account_username_not_null",
          "definition": "NOT NULL username"
        }
      ],
      "indexes": [
        {
          "name": "idx_gfa_admin_account_role_status",
          "definition": "CREATE INDEX idx_gfa_admin_account_role_status ON public.gfa_admin_account USING btree (role, status, id)"
        },
        {
          "name": "uq_gfa_admin_account_username_ci",
          "definition": "CREATE UNIQUE INDEX uq_gfa_admin_account_username_ci ON public.gfa_admin_account USING btree (lower(username))"
        }
      ],
      "triggers": null
    },
    {
      "name": "gfa_admin_audit_log",
      "comment": "Admin 操作的持久审计记录，保存操作者身份快照及变更前后内容",
      "columns": [
        {
          "name": "id",
          "data_type": "bigint",
          "not_null": true,
          "has_default": true,
          "default": "nextval('gfa_admin_audit_log_id_seq'::regclass)",
          "comment": "Admin 操作的持久审计记录的行身份；用于稳定引用该记录"
        },
        {
          "name": "action",
          "data_type": "character varying(64)",
          "not_null": true,
          "has_default": false,
          "comment": "发生的业务操作代码，用于检索和解释审计事件"
        },
        {
          "name": "resource",
          "data_type": "character varying(128)",
          "not_null": true,
          "has_default": false,
          "comment": "被操作的资源类型代码；不是数据库连接名"
        },
        {
          "name": "target_id",
          "data_type": "character varying(128)",
          "not_null": false,
          "has_default": false,
          "comment": "被操作资源的文本身份；无单一目标的操作可为 NULL"
        },
        {
          "name": "operator",
          "data_type": "character varying(64)",
          "not_null": true,
          "has_default": false,
          "comment": "历史兼容的操作者文本；新身份另由账号、名称和角色快照保存"
        },
        {
          "name": "session_version",
          "data_type": "bigint",
          "not_null": true,
          "has_default": true,
          "default": "0",
          "comment": "操作发生时的会话版本；系统或旧记录可为零"
        },
        {
          "name": "request_id",
          "data_type": "character varying(128)",
          "not_null": false,
          "has_default": false,
          "comment": "关联本次 HTTP 请求的追踪标识；未提供时为 NULL"
        },
        {
          "name": "ip_address",
          "data_type": "character varying(64)",
          "not_null": false,
          "has_default": false,
          "comment": "审计请求来源地址；未取得时为 NULL，不用于重建角色权限"
        },
        {
          "name": "user_agent",
          "data_type": "text",
          "not_null": false,
          "has_default": false,
          "comment": "审计请求的 User-Agent；未取得时为 NULL"
        },
        {
          "name": "before_data",
          "data_type": "text",
          "not_null": false,
          "has_default": false,
          "comment": "操作前快照的序列化文本；敏感字段由调用方按审计策略脱敏，无快照时为空串或历史 NULL"
        },
        {
          "name": "after_data",
          "data_type": "text",
          "not_null": false,
          "has_default": false,
          "comment": "操作后快照的序列化文本；敏感字段由调用方按审计策略脱敏，无快照时为空串或历史 NULL"
        },
        {
          "name": "created_at",
          "data_type": "timestamp(0) without time zone",
          "not_null": true,
          "has_default": false,
          "comment": "Admin 操作的持久审计记录的记录创建时间"
        },
        {
          "name": "operator_account_id",
          "data_type": "bigint",
          "not_null": false,
          "has_default": false,
          "comment": "实际操作者账号；历史或系统操作可为 NULL，账号删除受外键限制"
        },
        {
          "name": "operator_name",
          "data_type": "text",
          "not_null": true,
          "has_default": false,
          "comment": "操作发生时的显示名称快照，不随账号改名回写"
        },
        {
          "name": "operator_role",
          "data_type": "text",
          "not_null": true,
          "has_default": false,
          "comment": "操作发生时的角色快照；系统操作使用 system"
        }
      ],
      "constraints": [
        {
          "name": "fk_gfa_admin_audit_operator_account",
          "definition": "FOREIGN KEY (operator_account_id) REFERENCES gfa_admin_account(id) ON DELETE RESTRICT"
        },
        {
          "name": "gfa_admin_audit_log_action_not_null",
          "definition": "NOT NULL action"
        },
        {
          "name": "gfa_admin_audit_log_created_at_not_null",
          "definition": "NOT NULL created_at"
        },
        {
          "name": "gfa_admin_audit_log_id_not_null",
          "definition": "NOT NULL id"
        },
        {
          "name": "gfa_admin_audit_log_operator_name_not_null",
          "definition": "NOT NULL operator_name"
        },
        {
          "name": "gfa_admin_audit_log_operator_not_null",
          "definition": "NOT NULL operator"
        },
        {
          "name": "gfa_admin_audit_log_operator_role_not_null",
          "definition": "NOT NULL operator_role"
        },
        {
          "name": "gfa_admin_audit_log_pkey",
          "definition": "PRIMARY KEY (id)"
        },
        {
          "name": "gfa_admin_audit_log_resource_not_null",
          "definition": "NOT NULL resource"
        },
        {
          "name": "gfa_admin_audit_log_session_version_not_null",
          "definition": "NOT NULL session_version"
        },
        {
          "name": "gfa_admin_audit_operator_name_check",
          "definition": "CHECK (btrim(operator_name) \u003c\u003e ''::text AND length(operator_name) \u003c= 128)"
        },
        {
          "name": "gfa_admin_audit_operator_role_check",
          "definition": "CHECK (operator_role = ANY (ARRAY['owner'::text, 'developer'::text, 'operator'::text, 'system'::text]))"
        }
      ],
      "indexes": [
        {
          "name": "idx_gfa_admin_audit_operator_account_created",
          "definition": "CREATE INDEX idx_gfa_admin_audit_operator_account_created ON public.gfa_admin_audit_log USING btree (operator_account_id, created_at DESC) WHERE (operator_account_id IS NOT NULL)"
        }
      ],
      "triggers": null
    },
    {
      "name": "gfa_collaboration_board_edge",
      "comment": "共享画布节点间的连线；节点删除时级联删除关联连线",
      "columns": [
        {
          "name": "id",
          "data_type": "bigint",
          "not_null": true,
          "has_default": true,
          "default": "nextval('gfa_collaboration_board_edge_id_seq'::regclass)",
          "comment": "共享画布节点间的连线的行身份；用于稳定引用该记录"
        },
        {
          "name": "source_id",
          "data_type": "bigint",
          "not_null": true,
          "has_default": false,
          "comment": "起点节点身份，引用同一共享画布的节点"
        },
        {
          "name": "target_id",
          "data_type": "bigint",
          "not_null": true,
          "has_default": false,
          "comment": "终点节点身份；不得与起点相同"
        },
        {
          "name": "source_handle",
          "data_type": "text",
          "not_null": true,
          "has_default": false,
          "comment": "起点连接方位 top、right、bottom 或 left"
        },
        {
          "name": "target_handle",
          "data_type": "text",
          "not_null": true,
          "has_default": false,
          "comment": "终点连接方位 top、right、bottom 或 left"
        },
        {
          "name": "routing",
          "data_type": "text",
          "not_null": true,
          "has_default": true,
          "default": "'curve'::text",
          "comment": "连线路径形态：curve 曲线或 step 折线"
        },
        {
          "name": "label",
          "data_type": "text",
          "not_null": true,
          "has_default": true,
          "default": "''::text",
          "comment": "连线上的说明文本，不超过 200 字符"
        },
        {
          "name": "color",
          "data_type": "text",
          "not_null": true,
          "has_default": true,
          "default": "'slate'::text",
          "comment": "画布语义色：sand、blue、green、rose 或 slate，不存任意 CSS"
        },
        {
          "name": "arrow",
          "data_type": "boolean",
          "not_null": true,
          "has_default": true,
          "default": "true",
          "comment": "是否显示连线方向箭头"
        },
        {
          "name": "created_by_account_id",
          "data_type": "bigint",
          "not_null": true,
          "has_default": false,
          "comment": "创建该协作对象的 Admin 账号身份，引用 gfa_admin_account"
        },
        {
          "name": "updated_by_account_id",
          "data_type": "bigint",
          "not_null": true,
          "has_default": false,
          "comment": "最近修改该协作对象的 Admin 账号身份，引用 gfa_admin_account"
        },
        {
          "name": "version",
          "data_type": "bigint",
          "not_null": true,
          "has_default": true,
          "default": "1",
          "comment": "乐观并发版本；修改时必须匹配旧版本并递增"
        },
        {
          "name": "created_at",
          "data_type": "timestamp(0) without time zone",
          "not_null": true,
          "has_default": true,
          "default": "CURRENT_TIMESTAMP",
          "comment": "共享画布节点间的连线的记录创建时间"
        },
        {
          "name": "updated_at",
          "data_type": "timestamp(0) without time zone",
          "not_null": true,
          "has_default": true,
          "default": "CURRENT_TIMESTAMP",
          "comment": "共享画布节点间的连线的记录最近更新时间"
        }
      ],
      "constraints": [
        {
          "name": "board_edge_connection_key",
          "definition": "UNIQUE (source_id, source_handle, target_id, target_handle)"
        },
        {
          "name": "board_edge_endpoints_check",
          "definition": "CHECK (source_id \u003c\u003e target_id)"
        },
        {
          "name": "gfa_collaboration_board_edge_arrow_not_null",
          "definition": "NOT NULL arrow"
        },
        {
          "name": "gfa_collaboration_board_edge_color_check",
          "definition": "CHECK (color = ANY (ARRAY['sand'::text, 'blue'::text, 'green'::text, 'rose'::text, 'slate'::text]))"
        },
        {
          "name": "gfa_collaboration_board_edge_color_not_null",
          "definition": "NOT NULL color"
        },
        {
          "name": "gfa_collaboration_board_edge_created_at_not_null",
          "definition": "NOT NULL created_at"
        },
        {
          "name": "gfa_collaboration_board_edge_created_by_account_id_fkey",
          "definition": "FOREIGN KEY (created_by_account_id) REFERENCES gfa_admin_account(id) ON DELETE RESTRICT"
        },
        {
          "name": "gfa_collaboration_board_edge_created_by_account_id_not_null",
          "definition": "NOT NULL created_by_account_id"
        },
        {
          "name": "gfa_collaboration_board_edge_id_not_null",
          "definition": "NOT NULL id"
        },
        {
          "name": "gfa_collaboration_board_edge_label_check",
          "definition": "CHECK (char_length(label) \u003c= 200)"
        },
        {
          "name": "gfa_collaboration_board_edge_label_not_null",
          "definition": "NOT NULL label"
        },
        {
          "name": "gfa_collaboration_board_edge_pkey",
          "definition": "PRIMARY KEY (id)"
        },
        {
          "name": "gfa_collaboration_board_edge_routing_check",
          "definition": "CHECK (routing = ANY (ARRAY['curve'::text, 'step'::text]))"
        },
        {
          "name": "gfa_collaboration_board_edge_routing_not_null",
          "definition": "NOT NULL routing"
        },
        {
          "name": "gfa_collaboration_board_edge_source_handle_check",
          "definition": "CHECK (source_handle = ANY (ARRAY['top'::text, 'right'::text, 'bottom'::text, 'left'::text]))"
        },
        {
          "name": "gfa_collaboration_board_edge_source_handle_not_null",
          "definition": "NOT NULL source_handle"
        },
        {
          "name": "gfa_collaboration_board_edge_source_id_fkey",
          "definition": "FOREIGN KEY (source_id) REFERENCES gfa_collaboration_board_node(id) ON DELETE CASCADE"
        },
        {
          "name": "gfa_collaboration_board_edge_source_id_not_null",
          "definition": "NOT NULL source_id"
        },
        {
          "name": "gfa_collaboration_board_edge_target_handle_check",
          "definition": "CHECK (target_handle = ANY (ARRAY['top'::text, 'right'::text, 'bottom'::text, 'left'::text]))"
        },
        {
          "name": "gfa_collaboration_board_edge_target_handle_not_null",
          "definition": "NOT NULL target_handle"
        },
        {
          "name": "gfa_collaboration_board_edge_target_id_fkey",
          "definition": "FOREIGN KEY (target_id) REFERENCES gfa_collaboration_board_node(id) ON DELETE CASCADE"
        },
        {
          "name": "gfa_collaboration_board_edge_target_id_not_null",
          "definition": "NOT NULL target_id"
        },
        {
          "name": "gfa_collaboration_board_edge_updated_at_not_null",
          "definition": "NOT NULL updated_at"
        },
        {
          "name": "gfa_collaboration_board_edge_updated_by_account_id_fkey",
          "definition": "FOREIGN KEY (updated_by_account_id) REFERENCES gfa_admin_account(id) ON DELETE RESTRICT"
        },
        {
          "name": "gfa_collaboration_board_edge_updated_by_account_id_not_null",
          "definition": "NOT NULL updated_by_account_id"
        },
        {
          "name": "gfa_collaboration_board_edge_version_check",
          "definition": "CHECK (version \u003e 0)"
        },
        {
          "name": "gfa_collaboration_board_edge_version_not_null",
          "definition": "NOT NULL version"
        }
      ],
      "indexes": [
        {
          "name": "idx_board_edge_target",
          "definition": "CREATE INDEX idx_board_edge_target ON public.gfa_collaboration_board_edge USING btree (target_id)"
        }
      ],
      "triggers": null
    },
    {
      "name": "gfa_collaboration_board_node",
      "comment": "协作中心唯一共享画布的节点；位置和尺寸更新也受版本检查",
      "columns": [
        {
          "name": "id",
          "data_type": "bigint",
          "not_null": true,
          "has_default": true,
          "default": "nextval('gfa_collaboration_board_node_id_seq'::regclass)",
          "comment": "协作中心唯一共享画布的节点的行身份；用于稳定引用该记录"
        },
        {
          "name": "body",
          "data_type": "text",
          "not_null": true,
          "has_default": true,
          "default": "''::text",
          "comment": "节点正文文本；不作为正式 Game/Nav 内容发布"
        },
        {
          "name": "x",
